# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pos

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Access-token lifetime. MUST carry a unit ('30m', '2h', '1d').
# A bare number here is read by jsonwebtoken as MILLISECONDS, so the old
# `JWT_EXPIRATION=86400` produced an 86-second token rather than 24 hours and
# logged users out mid-session. The app now refuses to boot on a unitless value.
JWT_ACCESS_EXPIRATION=30m

# Refresh-token lifetime in days. Rotation does not extend it: after this the
# user signs in again.
REFRESH_TOKEN_TTL_DAYS=7

# Signs the platform admin's "Open as owner / employee" links (one hour,
# single use). Deliberately a DIFFERENT secret from JWT_SECRET, so a link can
# never pass as an access token. At least 32 characters:
#   openssl rand -hex 32
# Leave blank and the feature answers 503 "not configured"; nothing else is
# affected. Must be set on the production host by hand (.env is not deployed).
IMPERSONATION_SECRET=

# How long audit rows (every write, every store) are kept before the nightly
# purge removes them. 0 keeps them forever. Minimum 7.
AUDIT_RETENTION_DAYS=90

# CORS Configuration
CORS_ORIGIN=http://localhost:8080

# Legacy: where store logos USED to be written and served from (/api/uploads/).
# Logos now live in the database and are served by GET /stores/:id/logo, so
# nothing new is written here. Kept only so files from before that move are
# still served (and cleaned up) where they survived. Safe to leave blank.
UPLOAD_DIR=

# Daily order-number reset. OrderSequenceResetService zeroes every restaurant's
# `stores.orderSequence` at this hour, so the first bill afterwards reads #1
# again. Only the DISPLAY number resets; `orders.orderNumber` is globally
# unique and untouched.
#
# The timezone is not optional in production: the server runs UTC, so a bare
# hour of 6 would fire at 11am in Karachi. Must be an IANA zone name.
ORDER_SEQUENCE_RESET_HOUR=6
ORDER_SEQUENCE_RESET_TIMEZONE=Asia/Karachi

# Silent QZ Tray printing. The web app presents QZ_SIGNING_CERT to QZ Tray and
# has every print request signed here with QZ_SIGNING_KEY; a station whose
# QZ Tray carries our root CA (qz-tray/override.crt) then prints with no
# "Allow" prompt. Both are PEM, base64-encoded onto one line:
#   base64 -i qz-tray/signing.key | tr -d '\n'
#   base64 -i qz-tray/signing.crt | tr -d '\n'
# Leave both blank and printing still works, with the prompt. See
# qz-tray/README.md.
QZ_SIGNING_KEY=
QZ_SIGNING_CERT=
